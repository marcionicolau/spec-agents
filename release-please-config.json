{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "separate-pull-requests": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "packages": {
    "packages/agent-fabric": {
      "release-type": "python",
      "package-name": "agent-fabric",
      "component": "agent-fabric",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name=='agent-fabric')].version"
        }
      ]
    },
    "packages/statistics": {
      "release-type": "python",
      "package-name": "statistics",
      "component": "statistics",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name=='statistics')].version"
        }
      ]
    },
    "packages/lakehouse": {
      "release-type": "python",
      "package-name": "lakehouse",
      "component": "lakehouse",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name=='lakehouse')].version"
        }
      ]
    },
    "packages/coworker": {
      "release-type": "python",
      "package-name": "coworker",
      "component": "coworker",
      "extra-files": [
        {
          "type": "toml",
          "path": "/uv.lock",
          "jsonpath": "$.package[?(@.name=='coworker')].version"
        }
      ]
    }
  }
}
